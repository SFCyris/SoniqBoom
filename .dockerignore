# Keep the build context (and image) lean — exclude everything the server
# doesn't need at runtime. The bundled frontend (soniqboom/frontend) IS needed.
.git
.gitignore
.venv
venv
**/__pycache__
**/*.pyc
**/*.pyo
node_modules
# Local runtime state / config — must NEVER be baked into the image. A shipped
# SoniqBoom.conf overrides the container's SONIQBOOM_DATA_DIR (so state stops
# persisting to the /data volume) and would leak the dev's paths/settings.
SoniqBoom.conf
.soniqboom.env
prefs.json
users.json
library.json
library.json.bak
library.aof
startup-status.json
freshness_state.json
/data
/log
/cache
# Build/packaging tooling and release artifacts — never needed at runtime.
installer
dist
*.sbz
# Bundled SoundFonts (~260 MB): the image ships the apt fluid-soundfont-gm
# instead and symlinks it in; add richer SoundFonts at runtime via Settings.
soundfonts
tests
*.log
.DS_Store
# NOTE: docs/manual/img is intentionally NOT excluded — the in-app manual
# (served from docs/manual/) references those 25 screenshots (~12 MB); excluding
# them 404s every image in the container's documentation.
internal
.pytest_cache
.mypy_cache
.ruff_cache
