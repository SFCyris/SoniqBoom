 extern unsigned short PalPitchTable[];
+// PalPitchTable's word for pitch `note`: below the table (-32 to -1) the
+// replayer reads the end of the Square wave stored before it (0x4040); past
+// the table's last entry (1951), that entry.
+static inline unsigned short PalPitchWord(int note) {
+    return note < 0 ? 0x4040 : PalPitchTable[note > 1951 ? 1951 : note];
+}
