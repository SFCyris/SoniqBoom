@@ -33,6 +37,16 @@
 
 #include "sidcxx11.h"
 
+/**
+ * Per-voice level tap (SoniqBoom).
+ * While sb_vu_tap is true, SID::clock() keeps the running maximum of
+ * |voice[i].output()| (pre-filter) in sb_vu_peak[i]. The caller resets
+ * sb_vu_peak. Off by default; when off, clock() is unchanged apart from
+ * one predicted-false branch per cycle.
+ */
+extern bool sb_vu_tap;
+extern float sb_vu_peak[3];
+
 namespace reSIDfp
 {
 
